# --- Pinecone ---
# Get from https://app.pinecone.io -> API Keys
PINECONE_API_KEY=pcsk_your_key_here
PINECONE_INDEX_NAME=rag-docs
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# --- DeepSeek ---
# Get from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your_key_here

# --- Flask ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED for sessions to work consistently across restarts.
FLASK_SECRET_KEY=replace_with_random_64_char_hex

# Set to "production" on Railway (enables secure cookies).
FLASK_ENV=development

# Local dev port (Railway injects PORT automatically).
FLASK_PORT=5000

# Shared knowledge base namespace (where admin_upload.py loads files).
SHARED_NAMESPACE=vifhe-kb

# --- Admin ---
# Random secret for /api/admin/* endpoints. Leave empty to disable admin endpoints.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=
